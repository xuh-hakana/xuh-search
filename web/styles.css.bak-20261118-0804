/* search · 界面沿用 Easydict：白底 + 浅灰卡片 + 蓝色链接，几乎不用边框 */
:root {
  --bg: #ffffff;
  --strip: #f2f2f4;
  --strip-2: #f7f7f8;
  --ink: #1d1d1f;
  --ink-2: #3a3a3c;
  --ink-3: #6e6e73;
  --muted: #8e8e93;
  --faint: #b0b0b5;
  --blue: #0a7cff;
  --blue-soft: #eaf3ff;
  --green: #248a3d;
  --orange: #c0472a;
  --hair: rgba(0, 0, 0, .06);
  --sans: -apple-system, BlinkMacSystemFont, "SF Pro SC", "PingFang SC", "Helvetica Neue", sans-serif;
  --mono: "SFMono-Regular", "SF Mono", Menlo, monospace;
  --r: 12px;
}

* { box-sizing: border-box; }
html { width: 100%; max-width: 100vw; overflow: hidden; }
html, body { height: 100%; }
body {
  margin: 0;
  background: transparent;
  color: var(--ink);
  font-family: var(--sans);
  font-size: 13px;
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
  overflow: hidden;
  user-select: none;
  -webkit-user-select: none;
}
button, input { font: inherit; color: inherit; }
button { border: 0; background: none; padding: 0; cursor: pointer; }
button:focus { outline: none; }
button:focus-visible, input:focus-visible { outline: 2px solid rgba(10, 124, 255, .45); outline-offset: 1px; border-radius: 6px; }
input { border: 0; outline: 0; background: transparent; user-select: text; -webkit-user-select: text; }
[hidden] { display: none !important; }
::selection { background: rgba(10, 124, 255, .18); }
.sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
.icon {
  width: 16px; height: 16px; flex: 0 0 auto;
  fill: none; stroke: currentColor; stroke-width: 1.6;
  stroke-linecap: round; stroke-linejoin: round;
}

/* ---------------- 外壳 ---------------- */
/* 竖向 flex：谁显谁隐都不会把别人的位置带歪，只有中间那块自己伸缩 */
/* 高度跟着内容走：内容少窗口就短，别留一大片空白（原生每变一次就跟着调窗口） */
.panel {
  height: 100%;
  min-height: 210px;
  width: 100%;
  max-width: 100vw;
  display: flex;
  flex-direction: column;
  min-height: 0;
  background: var(--bg);
  border-radius: 12px;
  overflow: hidden;
  border: .5px solid rgba(0, 0, 0, .12);
}

/* 本轮第一次有新结果：面板浮起并亮一下。
   浮动窗口永远盖在普通窗口之上，「从后面浮到最前面」看不出来，
   所以用一次短动画把「新内容到了」变成能看见的动作。 */
@keyframes panelJump {
  0%   { transform: translateY(0) scale(1);         border-color: rgba(0, 0, 0, .12);     box-shadow: 0 0 0 0 rgba(10, 124, 255, 0); }
  28%  { transform: translateY(-4px) scale(1.006);  border-color: rgba(10, 124, 255, .8); box-shadow: 0 10px 26px rgba(10, 124, 255, .3); }
  100% { transform: translateY(0) scale(1);         border-color: rgba(0, 0, 0, .12);     box-shadow: 0 0 0 0 rgba(10, 124, 255, 0); }
}
body.is-jump .panel { animation: panelJump .52s cubic-bezier(.2, .8, .3, 1) both; }

.topbar { flex: 0 0 42px; }
.roots, .axhint, .svcrow, .changes { flex: 0 0 auto; }

/* ---------------- 顶栏 ---------------- */
.topbar {
  display: flex; align-items: center; gap: 8px;
  padding: 0 10px 0 8px;
  background: var(--bg);
}
.topbar button { -webkit-app-region: no-drag; }
.pin {
  width: 28px; height: 28px; border-radius: 8px;
  display: grid; place-items: center; color: var(--muted);
  transform: rotate(0deg);
}
.pin:hover { background: var(--strip); color: var(--ink-2); }
.pin.is-on { color: var(--ink); }
.pin.is-on .icon { stroke-width: 1.9; }
.pin .icon { width: 15px; height: 15px; }

/* 状态这一条可以一直往右排长，排不下就横向滑着看，绝不把服务裁掉 */
.pills {
  display: flex; align-items: center; gap: 6px;
  flex: 1 1 auto; min-width: 0;
  overflow-x: auto; overflow-y: hidden;
  scrollbar-width: none;
  -webkit-mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 10px), transparent 100%);
  mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 10px), transparent 100%);
}
.pills::-webkit-scrollbar { display: none; }
.pill {
  display: inline-flex; align-items: center; gap: 5px;
  height: 22px; padding: 0 9px; border-radius: 11px;
  background: var(--strip); color: var(--ink-3);
  font-size: 11.5px; white-space: nowrap;
  transition: background .12s, color .12s;
}
.pill b { font-weight: 600; font-variant-numeric: tabular-nums; }
.pill:hover { background: #e9e9ec; color: var(--ink); }
.pill .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: .8; }
.pill-new { color: var(--green); background: #edf7ef; }
.pill-new:hover { background: #e2f2e6; }
.pill-warn { color: #a8641a; background: #fdf4e6; }
.pill-warn:hover { background: #faecd8; }
.dot-ok { background: #b6c0b8; }
/* 文件统计从底栏挪到顶栏：新增 / 已变更 / 正常 之后，窗口控制之前 */
.stat {
  flex: 0 0 auto;
  font-size: 10.5px; color: var(--faint);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  transition: color .15s;
}

.quick { margin-left: auto; display: flex; align-items: center; gap: 6px; }
.round {
  width: 22px; height: 22px; border-radius: 50%;
  display: grid; place-items: center;
  background: var(--strip); color: var(--ink-3);
  transition: background .16s, color .16s, transform .12s,
              width .18s cubic-bezier(.32, .72, 0, 1), height .18s cubic-bezier(.32, .72, 0, 1),
              border-radius .18s;
  overflow: hidden;
}
.round:hover { background: #e6e6ea; color: var(--ink); transform: translateY(-.5px); }
.round:active { transform: scale(.9); transition-duration: .07s; }
.round .icon { width: 12px; height: 12px; }

/* 分类总闸：亮 = 实心蓝（正常在跑）· 只关了其中几个 = 淡黄（提醒）· 全关 = 透明（这块停了） */
.round.tog { background: transparent; color: var(--ink-3); }
.round.tog:hover { background: #e9e9ec; color: var(--ink); }
.round.tog.is-on { background: var(--blue); color: #fff; }
.round.tog.is-on:hover { background: #096fe0; color: #fff; }
.round.tog.is-off { background: transparent; color: var(--faint); }
.round.tog.is-off:hover { background: #ececef; color: var(--ink-2); }
.round.tog.is-part { background: #ffe9a8; color: #7a5600; }         /* 只关几个 = 淡黄 */
.round.tog.is-part:hover { background: #fde79a; color: #6a4c00; }
/* 关掉的服务都进服务行小标，圆钮里不再写缩写 */
.round.tog .tick { display: none; }

/* 服务那一行：左边分类总闸 + 被关掉的服务小标（排不下就横着滑），右边是「关 / 开 / 简」 */
.svcrow {
  display: flex; align-items: center; gap: 8px;
  padding: 0 10px 8px;
  min-width: 0;
}
.svcrow .rail {
  flex: 1 1 auto; min-width: 0;
  display: flex; align-items: center; gap: 6px;
  overflow-x: auto; overflow-y: hidden;
  scrollbar-width: none;
  -webkit-mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 8px), transparent 100%);
  mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 8px), transparent 100%);
}
.svcrow .rail::-webkit-scrollbar { display: none; }
.svcrow .seg { flex: 0 0 auto; }
/* 关/开/简：上方一行标注【关/开/简】，下方就是三个按钮，不再写别的 */
.svcrow .verb-wrap {
  flex: 0 0 auto;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
}
.svcrow .verb-cap {
  font-size: 9.5px; color: var(--faint); line-height: 1;
  white-space: nowrap; letter-spacing: .02em;
}

/* 状态栏小标：所有被关掉的服务都缩到这儿，图标保持原本那个色块，不变黄 */
.src-tags {
  display: flex; align-items: center; gap: 3px;
  flex: 0 0 auto;          /* 一个都不许压扁，宁可排到屏幕外去 */
}
.src-tag {
  width: 18px; height: 18px; border-radius: 5px; flex: 0 0 auto;
  display: grid; place-items: center;
  background: var(--c, #8e8e93); color: #fff;
  font-size: 9.5px; font-weight: 700; line-height: 1;
  letter-spacing: 0;
  animation: tagIn .2s cubic-bezier(.32, .72, 0, 1) both;
}
.src-tag .icon { width: 11px; height: 11px; stroke-width: 2; }
.src-tag:hover { filter: brightness(1.18) saturate(1.1); }
.src-tag:active { transform: scale(.88); }
.src-tag.is-out { animation: tagOut .14s ease-in both; }
@keyframes tagOut {
  to { transform: scale(.35); opacity: 0; }
}
.src-tags:empty { display: none; }
/* 一个源都没关的时候，那两个开关后面不留一根孤零零的竖线 */
.svcrow:not(:has(.src-tag)) .qsep { display: none; }
/* 飞进来那一下的余韵：弹一下、晃两下才停 */
.src-tag.is-pop { animation: tagPop .5s cubic-bezier(.3, .9, .35, 1) both; }
@keyframes tagIn {
  from { opacity: 0; transform: scale(.55); }
  to   { opacity: 1; transform: none; }
}
@keyframes tagPop {
  0%   { transform: scale(1); }
  26%  { transform: scale(1.42) rotate(-8deg); }
  48%  { transform: scale(.9) rotate(5deg); }
  68%  { transform: scale(1.12) rotate(-3deg); }
  84%  { transform: scale(.97) rotate(1deg); }
  100% { transform: none; }
}
/* 抛物线飞行体：从被关的那张卡飞向状态栏，边飞边缩 */
.flier {
  position: fixed; left: 0; top: 0; z-index: 90;
  display: grid; place-items: center;
  border-radius: 4px; color: #fff; font-weight: 700;
  pointer-events: none; will-change: transform, opacity;
  box-shadow: 0 6px 16px rgba(0, 0, 0, .22);
}
.qsep {
  width: .5px; height: 13px; background: rgba(0, 0, 0, .12);
  margin: 0 1px; flex: 0 0 auto;
}

/* ---------------- 变更列表 ---------------- */
.changes {
  margin: 0 10px 6px; padding: 6px;
  background: var(--strip-2); border-radius: 10px;
  max-height: 150px; overflow: auto;
}
.change-row {
  display: flex; align-items: center; gap: 7px; width: 100%;
  padding: 5px 6px; border-radius: 7px; text-align: left;
  font-size: 11.5px; color: var(--ink-3);
}
.change-row:hover { background: rgba(0, 0, 0, .045); }
.change-row .name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.change-row .tag {
  font-size: 9.5px; padding: 1px 5px; border-radius: 4px;
  background: #fdf4e6; color: #a8641a;
}
.change-row.is-missing .tag { background: #fbeae7; color: #a94138; }
.change-row .tag-new { background: #edf7ef; color: #248a3d; }

/* ---------------- 登记文件夹 ---------------- */
.roots {
  display: flex; align-items: center; gap: 6px;
  padding: 0 10px 8px;
}
.roots-label {
  font-size: 11px; color: var(--faint); flex: 0 0 auto;
}
.root-chips { display: flex; gap: 5px; overflow-x: auto; flex: 1; scrollbar-width: none; }
.root-chips::-webkit-scrollbar { display: none; }
.root {
  display: inline-flex; align-items: center; gap: 4px;
  height: 22px; padding: 0 3px 0 8px; border-radius: 11px;
  background: var(--strip); font-size: 11.5px; color: var(--ink-3);
  white-space: nowrap;
  flex: 0 0 auto;          /* 不被 flex 压窄，测量出的宽度才是真实宽度 */
  cursor: grab;
  transition: background .12s, color .12s, transform .1s, box-shadow .14s, opacity .14s;
}
.root:hover { background: #e9e9ec; color: var(--ink); }
.root:active { cursor: grabbing; }
/* 拖拽中：浮起来、投影，像被拎起来的纸片 */
.root.is-dragging {
  cursor: grabbing;
  background: #fff; color: var(--ink);
  box-shadow: 0 6px 18px rgba(0, 0, 0, .2);
  transform: scale(1.04);
  z-index: 5;
}
.root.is-dead { opacity: .55; }
.root .x {
  width: 16px; height: 16px; border-radius: 50%; display: grid; place-items: center;
  color: var(--faint); opacity: 0; transition: opacity .12s, background .12s;
}
.root:hover .x { opacity: 1; }
.root .x:hover { background: rgba(169, 65, 56, .12); color: #a94138; }
.root .icon { width: 11px; height: 11px; }
.root-empty { font-size: 11.5px; color: var(--faint); }
.root.is-cb { background: #eeeefe; color: #4b4bc9; padding-right: 8px; }
.root.is-cb .icon { color: #5b5bd6; }
#dockBtn.is-on, #cornerBtn { color: #4b4bc9; background: #eeeefe; }
.root-add {
  width: 22px; height: 22px; border-radius: 50%; flex: 0 0 auto;
  display: grid; place-items: center; color: var(--muted);
  background: var(--strip);
}
.root-add:hover { background: #e6e6ea; color: var(--ink); }
.root-add .icon { width: 12px; height: 12px; }

/* 展开/收起入口：默认「+N ▾」向下展开；展开后变成「▴」收起 */
.root-more {
  display: inline-flex; align-items: center; gap: 1px;
  height: 22px; padding: 0 7px 0 8px; border-radius: 11px;
  flex: 0 0 auto; white-space: nowrap;
  background: var(--strip); color: var(--ink-3);
  font-size: 11.5px; font-weight: 500;
  transition: background .12s, color .12s;
}
.root-more:hover { background: #e9e9ec; color: var(--ink); }
.root-more:active { background: #e0e0e4; }
.root-more b { font-variant-numeric: tabular-nums; }
.root-more .icon { width: 12px; height: 12px; transition: transform .22s cubic-bezier(.32, .72, 0, 1); }
.root-more.is-open .icon { transform: rotate(180deg); }
/* 拖动时全局抓手光标 */
body.is-root-dragging, body.is-root-dragging .root { cursor: grabbing; }

/* ---------------- 主区域 ---------------- */
/* 竖向排：上面是卡片区，最底下是输入框。谁有内容谁撑高，整窗跟着长 */
.board {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  min-height: 0; min-width: 0;
}
.input-zone { flex: 0 0 auto; margin: 6px 0 4px; }

.input-card {
  margin: 0 10px;
  background: var(--strip);
  border-radius: var(--r);
  padding: 12px 12px 8px;
}
.term-input {
  width: 100%; height: 24px;
  font-size: 17px; letter-spacing: -.01em;
  color: var(--ink);
  padding: 0;
}
.term-input::placeholder { color: var(--faint); font-size: 14px; }
.input-foot { display: flex; align-items: center; gap: 8px; margin-top: 9px; }
.ico {
  width: 18px; height: 18px; display: grid; place-items: center;
  color: var(--ink-3); border-radius: 4px;
}
.ico:hover { color: var(--blue); }
.ico .icon { width: 14px; height: 14px; }
.ico-close { margin-left: auto; }
.badge {
  height: 20px; padding: 0 8px; border-radius: 10px;
  display: inline-flex; align-items: center; gap: 3px;
  background: rgba(0, 0, 0, .045);
  font-size: 11px; color: var(--ink-3);
}
.badge b { color: var(--blue); font-weight: 500; }
.badge-scope { cursor: pointer; color: var(--ink-3); }
.badge-scope:hover { background: rgba(0, 0, 0, .075); color: var(--ink); }
.badge-scope.is-on { background: var(--blue-soft); color: var(--blue); }
.input-note { font-size: 10.5px; color: var(--faint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.pair-row {
  display: flex; align-items: center; gap: 8px;
  margin: 8px 10px 4px; padding: 0 2px;
  font-size: 12.5px; color: var(--ink-2);
  min-height: 18px;
}
.pair {
  max-width: 46%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  color: var(--blue);
}
.pair-arrow { color: var(--faint); font-size: 11px; }

/* 滚动区：卡片在这儿堆叠；内容多就长，长到上限才自己滚。
   没词也没卡时整块收起，面板直接缩到只剩输入框，不留下半屏空白 */
.scroll {
  flex: 1 1 auto;
  overflow-y: auto; overflow-x: hidden;
  padding: 2px 10px 12px;
  scrollbar-width: thin;
  min-width: 0;
  max-height: 480px;      /* 再多就在这儿滚，窗口不无限长 */
}
.scroll.is-empty { display: none; }
/* 长路径/长单词不许把版面撑宽 */
.block, .block-body, .def, .layer p, .web-sum, .hit-snippet, .word {
  overflow-wrap: anywhere;
  word-break: break-word;
  min-width: 0;
}
.scroll::-webkit-scrollbar { width: 9px; }
.scroll::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, .16); border-radius: 5px; border: 3px solid var(--bg);
}
.scroll::-webkit-scrollbar-track { background: transparent; }

/* ---------------- 卡片块 ---------------- */
.block {
  max-width: 100%;
  border-radius: var(--r);
  animation: blockIn .26s cubic-bezier(.32, .72, 0, 1) both;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 1px 2px rgba(0, 0, 0, .05), 0 0 0 .5px rgba(0, 0, 0, .05);
  margin-bottom: 9px;
}
.block-head {
  display: flex; align-items: center; gap: 7px;
  height: 34px; padding: 0 10px;
  background: var(--strip);
  cursor: pointer;
}
.block-head:hover { background: #ececef; }
.svc {
  width: 17px; height: 17px; border-radius: 4.5px;
  display: grid; place-items: center;
  color: #fff; font-size: 9px; font-weight: 700;
  flex: 0 0 auto;
}
.svc .icon { width: 11px; height: 11px; stroke-width: 2; }
.svc.is-local { background: #34c759; }
.svc.is-files { background: #0a7cff; }
.svc.is-cb { background: #5b5bd6; }
.svc.is-baidu { background: #2932e1; }
.svc.is-mdn { background: #1b1b1b; }
.svc.is-so { background: #f48024; }
.svc.is-wiki { background: #636466; }
.svc.is-moe { background: #ff7ba9; }
.svc.is-easy { background: #c0472a; }
.svc.is-deepl { background: #0f2b46; }
.block-name { font-size: 12.5px; font-weight: 500; color: var(--ink); }
.block-sub { font-size: 10.5px; color: var(--faint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 卡片头右侧那排小工具：转轮（在查）→ 关掉这个源 → 收起 */
.block-head .head-tools {
  margin-left: auto; flex: 0 0 auto;
  display: flex; align-items: center; gap: 3px;
}
.block-head .chev {
  color: var(--faint); width: 14px; height: 14px;
  transition: transform .26s cubic-bezier(.32, .72, 0, 1);
}
/* 卡片头上的「关掉这个源」：一直看得见（不然她根本不知道能关），鼠标放上去变深 */
.block-head .svc-off {
  width: 17px; height: 17px; border-radius: 5px;
  display: grid; place-items: center;
  color: var(--faint); opacity: .75;
  transition: opacity .12s, background .12s, color .12s;
}
.block-head:hover .svc-off { opacity: 1; }
.block-head .svc-off:hover { background: rgba(169, 65, 56, .12); color: var(--ink-2); }
.block-head .svc-off .icon { width: 11px; height: 11px; }
/* 还在查的卡：右上角一个「关闭」，点一下把这张卡收起来（不是关掉这个源） */
.block-head .svc-close {
  width: 17px; height: 17px; border-radius: 5px; flex: 0 0 auto;
  display: grid; place-items: center;
  color: var(--faint); opacity: .75;
  transition: opacity .12s, background .12s, color .12s;
}
.block-head:hover .svc-close { opacity: 1; }
.block-head .svc-close:hover { background: rgba(0, 0, 0, .07); color: var(--ink-2); }
.block-head .svc-close .icon { width: 11px; height: 11px; }
.block.is-folded .chev { transform: rotate(-90deg); }

/* 折叠用 grid 行高过渡，跟 macOS 列表一样是「慢慢收起来」而不是瞬间消失 */
.fold {
  display: grid; grid-template-rows: 1fr;
  transition: grid-template-rows .26s cubic-bezier(.32, .72, 0, 1),
              opacity .2s ease;
}
.fold-in { overflow: hidden; min-height: 0; }
.block.is-folded .fold { grid-template-rows: 0fr; opacity: 0; }

.block-body { padding: 10px 12px 2px; }
.block-foot {
  display: flex; align-items: center; gap: 14px;
  padding: 8px 12px 10px;
}

/* 词库正文 */
.word {
  margin: 0 0 6px; font-size: 16.5px; font-weight: 650; letter-spacing: -.01em;
  line-height: 1.34; word-break: break-word; user-select: text; -webkit-user-select: text;
}
.def {
  margin: 0 0 9px; font-size: 12.5px; line-height: 1.6; color: var(--ink-2);
  user-select: text; -webkit-user-select: text;
}
.layers { border-top: .5px solid var(--hair); padding-top: 9px; margin-bottom: 8px; }
.layer { margin-bottom: 8px; }
.layer:last-child { margin-bottom: 4px; }
.layer h4 {
  margin: 0 0 2px; font-size: 10px; letter-spacing: .06em;
  color: var(--faint); font-weight: 500;
}
.layer p {
  margin: 0; font-size: 12px; line-height: 1.58; color: var(--ink-2);
  user-select: text; -webkit-user-select: text;
}

/* 文件命中 */
.hit {
  display: block; width: 100%; text-align: left;
  padding: 8px 0; border-top: .5px solid var(--hair);
  position: relative;
}
.hit:first-child { border-top: 0; padding-top: 2px; }
.hit:hover .hit-name { color: var(--blue); }
.hit-top { display: flex; align-items: center; gap: 6px; }
.hit-name {
  font-size: 12.5px; font-weight: 500; color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.hit-line {
  font-family: var(--mono); font-size: 9.5px; color: var(--blue);
  background: var(--blue-soft); padding: 0 4px; border-radius: 3px; flex: 0 0 auto;
}
.hit-dir {
  font-size: 10.5px; color: var(--faint); margin-left: auto;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 42%;
}
.hit-snippet {
  margin-top: 2px; font-size: 11.5px; line-height: 1.52; color: var(--ink-3);
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.hit-snippet mark { background: #fff0c2; color: var(--ink); border-radius: 2px; padding: 0 1px; }
.hit-reveal {
  position: absolute; right: 0; bottom: 8px;
  width: 18px; height: 18px; border-radius: 4px; display: grid; place-items: center;
  color: var(--faint); opacity: 0; transition: opacity .12s;
}
.hit:hover .hit-reveal { opacity: 1; }
.hit-reveal:hover { color: var(--blue); }
.hit-reveal .icon { width: 12px; height: 12px; }

/* 联网摘要 */
.web-sum {
  margin: 0 0 7px; font-size: 12.5px; line-height: 1.58; color: var(--ink-2);
  user-select: text; -webkit-user-select: text;
}
.web-link {
  font-size: 11.5px; color: var(--blue); display: inline-flex; align-items: center; gap: 4px;
  margin-bottom: 8px;
}
.web-link:hover { text-decoration: underline; }
.web-link .icon { width: 11px; height: 11px; }
/* 源接口报错：只给标志，不贴报错原文 */
.web-err {
  margin: 0; font-size: 12px; color: var(--muted);
  display: inline-flex; align-items: center; gap: 6px;
}
.web-err .err-dot {
  width: 14px; height: 14px; border-radius: 50%; flex: none;
  background: #f6d9d9; color: #b4232b; font-size: 10px; font-weight: 700;
  display: inline-flex; align-items: center; justify-content: center;
}
.block.is-bad { background: #fffafa; }
.block.is-bad .block-name { color: var(--muted); }

.empty { padding: 18px 4px; }
.empty p { margin: 0; font-size: 12px; color: var(--faint); text-align: center; }

/* 骨架 */
.skeleton { padding: 10px 2px; }
.sk-line {
  display: block; height: 8px; border-radius: 4px; margin-bottom: 7px;
  background: linear-gradient(90deg, #efefef 25%, #f7f7f7 37%, #efefef 63%);
  background-size: 400% 100%; animation: shine 1.3s ease-in-out infinite;
}
.sk-line.short { width: 52%; }
@keyframes shine { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }

/* ---------------- 底栏 ---------------- */
/* 贴底的玻璃条：不画硬线，靠模糊和一点点阴影跟内容分开 */
.foot {
  flex: 0 0 36px;
  display: flex; align-items: center; justify-content: flex-end;
  padding: 0 12px 1px;
  position: relative;
  background: rgba(252, 252, 253, .78);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  backdrop-filter: saturate(180%) blur(20px);
}
.foot::before {
  content: ""; position: absolute; left: 0; right: 0; top: 0; height: .5px;
  background: rgba(0, 0, 0, .07);
}
/* 关 / 开 / 简：三态，不用蓝色。
   关 = 透明（连对照都不要）· 开 = 白底（完整）· 简 = 黄底（只留中英对照 + 一句话） */
.seg {
  flex: 0 0 auto;
  display: inline-flex; padding: 2px;
  background: rgba(120, 120, 128, .13); border-radius: 8px;
}
.seg button {
  position: relative; z-index: 1;
  width: 32px; font-size: 11px; line-height: 17px;
  color: var(--ink-3); border-radius: 6px;
  transition: background .16s, color .16s;
}
.seg button:hover { color: var(--ink-2); }
.seg button.is-on[data-v="off"]   { background: transparent; color: var(--muted); }
.seg button.is-on[data-v="full"]  { background: #fff; color: var(--ink);
  box-shadow: 0 1px 2.5px rgba(0, 0, 0, .13), 0 0 0 .5px rgba(0, 0, 0, .045); }
.seg button.is-on[data-v="brief"] { background: #ffd447; color: #4a3506; }

/* ---------------- 轻提示 ---------------- */
.toast-layer {
  position: fixed; left: 50%; bottom: 56px; transform: translateX(-50%);
  display: flex; flex-direction: column; gap: 6px; align-items: center;
  pointer-events: none; z-index: 60;
}
.toast {
  background: rgba(29, 29, 31, .92); color: #fff;
  font-size: 11.5px; padding: 6px 12px; border-radius: 10px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, .18);
  animation: toastIn .18s ease-out; max-width: 88%;
}
.toast.is-bad { background: rgba(169, 65, 56, .95); }
@keyframes toastIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

/* 关 = 一键收起全部卡片 · 开 = 一键展开全部卡片 · 简 = 词义精简（只中英对照＋一句话） */
/* 关/开：全局强制开/合所有卡片正文（覆盖单卡 is-folded，优先级高于它） */
body.all-expand .block .fold { grid-template-rows: 1fr; opacity: 1; }
body.all-expand .block .chev { transform: none; }
body.all-collapse .block .fold { grid-template-rows: 0fr; opacity: 0; }
body.all-collapse .block .chev { transform: rotate(-90deg); }
/* 简：隐藏五层解释，只留中英对照（顶部 pair-row）＋一句话（.def） */
body.is-brief .layers { display: none; }


/* ---------------- 入场 / 交互动效 ---------------- */
@keyframes blockIn {
  from { opacity: 0; transform: translateY(5px) scale(.995); }
  to   { opacity: 1; transform: none; }
}
/* 同一批出来的卡片依次浮现，不是一起跳出来 */
#blocks > .block:nth-child(1) { animation-delay: 0ms; }
#blocks > .block:nth-child(2) { animation-delay: 44ms; }
#blocks > .block:nth-child(3) { animation-delay: 88ms; }
#blocks > .block:nth-child(4) { animation-delay: 132ms; }
#blocks > .block:nth-child(n+5) { animation-delay: 168ms; }

/* 联网卡片：从面板外面半透明滑进来，一条条错开，像纸牌被一张张推到桌上 */
.block.is-web {
  animation: webIn .46s cubic-bezier(.2, .86, .26, 1) both;
  animation-delay: var(--d, 0ms);
}
@keyframes webIn {
  0%   { opacity: 0; transform: translateX(calc(100% + 40px)); }
  45%  { opacity: .55; }
  100% { opacity: 1; transform: none; }
}
/* 还在查的源：卡片先摆着，收起来，头上一圈小转轮 */
.block.is-wait { background: #fcfcfd; }
.block.is-wait .block-head { background: var(--strip-2); }
.block.is-wait .block-name { color: var(--muted); }
.spin {
  width: 12px; height: 12px; flex: 0 0 auto;
  border-radius: 50%;
  border: 1.4px solid rgba(0, 0, 0, .1);
  border-top-color: var(--muted);
  animation: spin .72s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* 内容滚到底那 16px 柔化，提示「下面还有」；滚到底就消失 */
.scroll {
  -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 calc(100% - 18px), transparent 100%);
  mask-image: linear-gradient(to bottom, #000 0, #000 calc(100% - 18px), transparent 100%);
  transition: -webkit-mask-image .2s;
}
.scroll.at-end {
  -webkit-mask-image: none; mask-image: none;
}

/* 词头出现时轻轻浮一下 */
.word { animation: wordIn .3s cubic-bezier(.32, .72, 0, 1) both; }
@keyframes wordIn {
  from { opacity: 0; transform: translateY(3px); letter-spacing: .01em; }
  to   { opacity: 1; transform: none; }
}

/* 开关按下时的水波感 */
.pill:active, .root:active, .badge-scope:active { transform: scale(.96); }
.pill, .root, .badge-scope { transition: background .14s, color .14s, transform .1s; }


/* 辅助功能没开时的一条细提示（不占地方，点一下就去设置） */
.axhint {
  display: flex; align-items: center; gap: 8px;
  margin: 0 10px 6px; padding: 6px 8px 6px 10px;
  background: #fdf6e7; border-radius: 8px;
  font-size: 11.5px; color: #8a6316;
  animation: blockIn .24s cubic-bezier(.32,.72,0,1) both;
}
.axhint-t { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#axGo {
  flex: 0 0 auto; font-size: 11.5px; color: #8a6316; font-weight: 550;
  padding: 1px 6px; border-radius: 5px; background: rgba(138, 99, 22, .1);
}
#axGo:hover { background: rgba(138, 99, 22, .18); }
.axhint-x { flex: 0 0 auto; color: #b09256; display: grid; place-items: center; width: 16px; height: 16px; }
.axhint-x .icon { width: 10px; height: 10px; }
.axhint-x:hover { color: #8a6316; }


/* ---------------- 查梗 · 娱乐网站 面板 ---------------- */
/* 半透明遮罩，点遮罩或右上角 × 关掉。面板本体是白卡，沿用浅灰卡片＋蓝链接风格 */
.modal {
  position: fixed; inset: 0; z-index: 50;
  display: flex; align-items: center; justify-content: center;
  background: rgba(20, 20, 22, .42);
  backdrop-filter: blur(2px);
  padding: 18px;
  animation: memeFade .16s ease-out;
}
.modal[hidden] { display: none !important; }
@keyframes memeFade { from { opacity: 0; } to { opacity: 1; } }

.meme-card {
  width: 100%; max-width: 460px; max-height: 100%;
  background: var(--bg); border-radius: 16px;
  box-shadow: 0 24px 70px rgba(0, 0, 0, .28);
  display: flex; flex-direction: column; overflow: hidden;
  animation: memePop .18s cubic-bezier(.32, .72, 0, 1);
}
@keyframes memePop { from { opacity: 0; transform: translateY(8px) scale(.98); } to { opacity: 1; transform: none; } }

.modal-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 16px 10px;
}
.modal-head h2 {
  margin: 0; font-size: 15px; font-weight: 650; color: var(--ink);
  display: flex; align-items: center; gap: 7px;
}
.modal-head h2::before {
  content: ""; width: 8px; height: 8px; border-radius: 50%;
  background: var(--blue); box-shadow: 0 0 0 3px var(--blue-soft);
}
.modal-x {
  width: 26px; height: 26px; display: grid; place-items: center;
  font-size: 20px; line-height: 1; color: var(--ink-3); border-radius: 8px;
}
.modal-x:hover { background: var(--strip); color: var(--ink); }

/* 查词输入行 */
.meme-search {
  display: flex; gap: 8px; padding: 2px 16px 12px;
}
.meme-input {
  flex: 1 1 auto; min-width: 0;
  background: var(--strip-2); border: 1px solid var(--hair);
  border-radius: 10px; padding: 9px 12px; font-size: 13px; color: var(--ink);
}
.meme-input::placeholder { color: var(--faint); }
.meme-input:focus { background: #fff; border-color: rgba(10, 124, 255, .5); }
.meme-search .btn {
  flex: 0 0 auto; background: var(--blue); color: #fff;
  font-size: 13px; font-weight: 600; padding: 0 18px; border-radius: 10px;
}
.meme-search .btn:hover { background: #0a6fe0; }
.meme-search .btn:active { transform: translateY(.5px); }

/* 内联查到的结果（站点 API 命中才显示） */
.meme-result { padding: 0 16px; }
.meme-result:not(:empty) {
  margin-bottom: 12px; padding: 10px 12px;
  background: var(--blue-soft); border-radius: 10px;
  font-size: 12.5px; line-height: 1.5; color: var(--ink-2);
  animation: memePop .18s cubic-bezier(.32, .72, 0, 1);
}
.meme-result .mr-src {
  display: inline-block; font-size: 11px; font-weight: 600;
  color: var(--blue); margin-bottom: 3px;
}
.meme-result .mr-title { font-weight: 600; color: var(--ink); }
.meme-result .mr-empty { color: var(--muted); }

/* 站点目录分段标题 */
.meme-dir-head {
  padding: 4px 16px 8px;
  font-size: 11.5px; font-weight: 600; color: var(--ink-3);
  letter-spacing: .02em;
  display: flex; align-items: baseline; justify-content: space-between; gap: 8px;
}
.meme-dir-head small { font-size: 10.5px; font-weight: 400; color: var(--muted); white-space: nowrap; }

/* 站点目录：单列卡片，点链接或搜一下都行 */
.meme-dir {
  padding: 0 16px 16px; overflow-y: auto;
  display: flex; flex-direction: column; gap: 8px;
}
.meme-site {
  display: flex; align-items: center; gap: 10px;
  background: var(--strip-2); border: 1px solid var(--hair);
  border-radius: 11px; padding: 9px 11px;
}
.meme-site .ms-main { flex: 1 1 auto; min-width: 0; }
.meme-site .ms-name {
  font-size: 13px; font-weight: 600; color: var(--ink);
  display: flex; align-items: center; gap: 7px;
}
.meme-site .ms-note {
  font-size: 11px; color: var(--ink-3); margin-top: 2px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.meme-site .ms-actions { flex: 0 0 auto; display: flex; gap: 6px; }
.meme-site .ms-btn {
  font-size: 11.5px; font-weight: 550; padding: 5px 10px; border-radius: 8px;
  background: #fff; color: var(--blue); border: 1px solid rgba(10, 124, 255, .28);
  white-space: nowrap;
}
.meme-site .ms-btn:hover { background: var(--blue-soft); }
.meme-site .ms-btn.go { background: var(--blue); color: #fff; border-color: transparent; }
.meme-site .ms-btn.go:hover { background: #0a6fe0; }

/* 可靠度徽标：alive=绿／doubtful=黄／dead=灰 */
.meme-site .ms-badge {
  flex: 0 0 auto; font-size: 10px; font-weight: 600; padding: 1px 7px;
  border-radius: 999px; line-height: 16px;
}
.meme-site .ms-badge.alive    { background: rgba(36, 138, 61, .14);  color: var(--green); }
.meme-site .ms-badge.doubtful { background: rgba(192, 124, 42, .16); color: #b9781f; }
.meme-site .ms-badge.dead     { background: rgba(142, 142, 147, .16); color: var(--muted); }

.meme-dir-empty { padding: 4px 16px 16px; color: var(--muted); font-size: 12px; }
